quarkus:
  datasource:
    jdbc:
      url: "jdbc:sqlite:data/db/local.db"

monitor:
  # Path to the polymorphic monitored-resources file (filesystem first, then classpath).
  # Copy monitored-resources-dev.yaml.dist to monitored-resources-dev.yaml and edit it.
  resources-file: monitored-resources-dev.yaml

backup:
  enabled: true
  cron: "0 0 * * * ?"  # hourly
  s3:
    key-prefix: sqlite/
    endpoint: http://localhost:8333
    bucket: wombat-bucket
    access-key: admin
    secret-key: secret
