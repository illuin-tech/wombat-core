environments:
  preprod:
    name: Preprod
    assets:
      - type: KUBERNETES_API
        id: my-cluster
        name: My cluster (preprod)
        namespace: my-namespace
        config-path: /path/to/kubeconfig
        # Impact profile (formerly a shared profile referenced by profile-id), now inlined per asset.
        profile:
          provider: aws
          instance-type: c5a.4xlarge
          location: FRA
          lifespan: 43800  # hours
      - type: LLM_STATIC
        id: my-llm
        name: My LLM (preprod)
        profile:
          provider: mistralai
          model: mistral-large-latest
          location: FRA
          request-profile:
            output-token-count: 500
            request-per-year: 1000000000
